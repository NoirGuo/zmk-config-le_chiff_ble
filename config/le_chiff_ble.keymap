#define ZMK_MOUSE_DEFAULT_SCRL_VAL 35 // 10

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        CAP {
            bindings = <&kp CAPS>;
            key-positions = <10 11>;
            timeout-ms = <120>;
        };

        CTR {
            bindings = <&kp LCTRL>;
            key-positions = <11 12>;
            timeout-ms = <120>;
        };

        ALT {
            bindings = <&kp LALT>;
            key-positions = <12 13>;
            timeout-ms = <120>;
        };

        SHIFT1 {
            bindings = <&kp LSHFT>;
            key-positions = <20 21>;
            timeout-ms = <120>;
        };

        SHIFT2 {
            bindings = <&kp RSHFT>;
            key-positions = <29 28>;
            timeout-ms = <120>;
        };

        EESC {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            timeout-ms = <120>;
        };

        DELE {
            bindings = <&kp DEL>;
            key-positions = <8 9>;
            timeout-ms = <120>;
        };
    };

    macros {
        MIMA: MIMA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N1 &kp N5 &kp N0 &kp N5 &kp N0 &kp N7>;
            label = "MIMA";
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        /*
         * Runtime sensor rotate 实例（DYA Studio 可在线改写 cw/ccw）。
         * cw/ccw-binding 仅作为 runtime 未配置时的 fallback 默认值。
         */
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Qwery {
            label = "Qwerty";
            bindings = <
&kp Q  &kp W  &kp E     &kp R        &kp T  &kp Y  &kp U        &kp I          &kp O    &kp P
&kp A  &kp S  &kp D     &kp F        &kp G  &kp H  &kp J        &kp K          &kp L    &kp ENTER
&kp Z  &kp X  &kp C     &kp V        &kp B  &kp N  &kp M        &kp COMMA      &kp DOT  &kp FSLH
              &kp LGUI  &lt 1 SPACE  &none  &none  &lt 2 SPACE  &kp BACKSPACE  &MIMA
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_1 {
            bindings = <
&kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6    &kp N7    &kp N8     &kp N9     &kp N0
&trans  &trans  &trans  &trans  &trans  &kp LBKT  &kp RBKT  &kp MINUS  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans     &trans     &trans
                &trans  &trans  &trans  &trans    &trans    &trans     &trans
            >;

            sensor-bindings = <&rsr_scroll>;
        };

        layer_2 {
            bindings = <
&trans    &kp UP    &trans     &trans       &trans      &trans        &trans        &trans        &trans  &trans
&kp LEFT  &kp DOWN  &kp RIGHT  &trans       &trans      &trans        &trans        &trans        &trans  &trans
&trans    &trans    &trans     &bootloader  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &trans
                    &trans     &trans       &trans      &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol>;
        };
    };
};
